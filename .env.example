# Copy to .env.local for local builds. Both are optional and empty by default.

# If set, an optional "stay in touch" screen appears and answers + match + helpful
# vote are POSTed here as JSON. If empty, nothing is ever sent anywhere.
SUBMIT_WEBHOOK_URL=

# Cloudflare Web Analytics (cookieless) site token. If empty, no analytics script is added.
CF_ANALYTICS_TOKEN=
